# Base44 app configuration for local frontend development.
# Copy to .env.local and fill in your values.

VITE_BASE44_APP_ID=your_app_id
# Production marketing site (Base44 custom domain)
VITE_BASE44_APP_BASE_URL=https://anatome.dev

# Optional: pin a specific functions version
# VITE_BASE44_FUNCTIONS_VERSION=

# Local Worker API (serves retimed GIFs from api/public/gifs/)
# VITE_PUBLIC_API=http://localhost:8787
