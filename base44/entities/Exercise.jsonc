{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "ext_id": {
      "type": "string",
      "description": "Source ExerciseDB id (e.g. Bench_Press)"
    },
    "name": {
      "type": "string",
      "description": "Exercise name"
    },
    "name_lower": {
      "type": "string",
      "description": "Lowercased name for fuzzy search"
    },
    "force": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "mechanic": {
      "type": "string"
    },
    "equipment": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "primaryMuscles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source primary muscle names"
    },
    "secondaryMuscles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source secondary muscle names"
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anatome_primary_slugs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mapped canonical Anatome primary slugs"
    },
    "anatome_secondary_slugs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mapped canonical Anatome secondary slugs"
    },
    "anatome_layers_payload": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Layer JSON ready for generateImage"
    },
    "anatome_imageSrc": {
      "type": "string",
      "description": "Pre-computed compact GET URL for <img src>"
    },
    "unmapped_source_muscle": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source muscle names that did not map to an Anatome slug"
    }
  },
  "required": [
    "ext_id",
    "name"
  ]
}