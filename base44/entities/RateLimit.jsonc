{
  "name": "RateLimit",
  "type": "object",
  "properties": {
    "key_type": {
      "type": "string",
      "enum": [
        "ip_day",
        "host_month"
      ],
      "default": "ip_day",
      "description": "Bucket type: ip_day (localhost/private IPs, 1000/day) or host_month (public hosts, 100/month)"
    },
    "ip_hash": {
      "type": "string",
      "description": "SHA-256 hash of the client IP (ip_day buckets). No raw IPs stored, GDPR-safe"
    },
    "host_hash": {
      "type": "string",
      "description": "SHA-256 hash of the public hostname (host_month buckets)"
    },
    "date": {
      "type": "string",
      "description": "Bucket period: YYYY-MM-DD for ip_day, YYYY-MM for host_month"
    },
    "count": {
      "type": "number",
      "default": 0,
      "description": "Requests made in this bucket"
    },
    "last_request_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last request"
    }
  },
  "required": [
    "date"
  ]
}