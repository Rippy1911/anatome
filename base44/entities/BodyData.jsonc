{
  "name": "BodyData",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique key: e.g. bodyFrontMale, bodyBackMale, bodyFrontFemale, bodyBackFemale"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "side": {
      "type": "string",
      "enum": [
        "front",
        "back"
      ]
    },
    "parts": {
      "type": "array",
      "description": "Array of { slug, path: { common?, left?, right? } } entries",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "key",
    "gender",
    "side",
    "parts"
  ]
}