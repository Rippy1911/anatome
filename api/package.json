{
  "name": "anatome-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Anatome public API on Cloudflare Workers (Hono).",
  "license": "Apache-2.0",
  "scripts": {
    "worker:dev": "wrangler dev",
    "worker:test": "vitest run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:all": "npm run test && npm run test:workers",
    "db:migrate:local": "wrangler d1 migrations apply anatome --local",
    "db:migrate": "wrangler d1 migrations apply anatome --remote",
    "predeploy": "node ../scripts/sync-public.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
